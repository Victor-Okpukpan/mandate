# MANDATE — environment configuration
#
# Copy to .env and fill in. Every address below is public, verified on-chain deployed contract
# state (see the sponsor addresses each chain publishes) — none of it is a secret. Nothing here
# is ever read into source; contracts and scripts load these at deploy/runtime only.
#
# NEVER put a private key here in plaintext. Deploy scripts use `forge script --account $ACCOUNT
# --sender $SENDER` against Foundry's encrypted keystore — see contracts/README.md — with the
# sole exception of a default Anvil test key for local development, explicitly marked as such.

# ---------------------------------------------------------------------------
# RPCs
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARC_RPC_URL=https://rpc.testnet.arc.network

# ---------------------------------------------------------------------------
# ENSv2 — Sepolia (authority plane). Verified two independent ways: documentary
# (docs.ens.domains/learn/deployments) and structural (contracts vouch for each other on-chain).
# ---------------------------------------------------------------------------
SEPOLIA_ROOT_REGISTRY=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
SEPOLIA_ETH_REGISTRY=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
SEPOLIA_ETH_REGISTRAR=0xa88553f454b77203b0d036a05c894d555eaaa2cc
SEPOLIA_USER_REGISTRY_IMPL=0x624a25d67b59d587752ebec8dded8827dae52050
SEPOLIA_PERMISSIONED_RESOLVER_IMPL=0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e
SEPOLIA_UNIVERSAL_RESOLVER_V2=0x4a1817d13e9cf196f471725176355c1234b63c70
SEPOLIA_VERIFIABLE_FACTORY=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
SEPOLIA_RENT_PRICE_ORACLE=0x8914b66260eb8c4fff795650c3ae8cd335958987
# ETHRegistrar prices 2LD registration in MockUSDC (6dp), not ETH — verified on-chain.
SEPOLIA_MOCK_USDC=0x768f42455a2d082e23ceef7d51e5787c82d67a39

# Set after DeployFactories.s.sol's runSepolia() runs, once per platform instance. Every org after
# that onboards through MandateOrgFactory itself (connect wallet, pick a name, sign) rather than a
# script — see HOW-IT-WORKS.md §4. Not required to build or unit-test.
SEPOLIA_MANDATE_ORG_FACTORY=
# Owner of MandateOrgFactory itself (duration/referrer config, token rescue) — NOT an org admin.
# Falls back to the deploying account if unset.
SEPOLIA_MANDATE_ORG_FACTORY_OWNER=

# Single-org fallback, kept for local dev and SeedDemo.s.sol: the registrar produced by one run of
# the factory flow above. Not required once org selection reads MandateOrgFactory's own events.
SEPOLIA_MANDATE_REGISTRAR=
# The org's chosen 2LD label ONLY, e.g. "acme" for "acme.eth" — never the full name, since
# ETHRegistrar's own commit-reveal decides the TLD. Matches whatever label the factory flow above
# registered for SEPOLIA_MANDATE_REGISTRAR.
ORG_ENS_LABEL=
# The org admin EOA/multisig for the single-org fallback above — MandateRegistrar's owner.
# A plain EOA is a testnet-only convenience (see contracts/README.md).
MANDATE_INITIAL_OWNER=

# ---------------------------------------------------------------------------
# Arc Testnet 5042002 (money plane). USDC is BOTH native gas (18dp) and an ERC-20 (6dp) at the
# same address — see packages/shared/src/decimals.ts, never inline a conversion.
# ---------------------------------------------------------------------------
ARC_USDC=0x3600000000000000000000000000000000000000
ARC_ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ARC_ERC8004_REPUTATION=0x8004B663056A597Dffe9eCcC1965A193B7388713
ARC_ERC8004_VALIDATION=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
ARC_ERC8183_JOBS=0x0747EEf0706327138c69792bF28Cd525089e4583

# Set after DeployFactories.s.sol's runArc() runs, once per platform instance.
ARC_VAULT_FACTORY=
ARC_VAULT_FACTORY_OWNER=

# Single-org fallback: the vault produced by one call to ArcVaultFactory.createVault. Not required
# once org selection reads ArcVaultFactory's own events.
ARC_MANDATE_ANCHOR=
ARC_AGENT_TREASURY=

# ---------------------------------------------------------------------------
# Privy — organization wallets, policies, key quorums, intents (M8 enforcer, M9 agents)
# ---------------------------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---------------------------------------------------------------------------
# Agent runtimes (M9)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Enforcer (M8) — the account whose signature MandateAnchor.syncMandate/heartbeat trusts.
# ENFORCER_ACCOUNT_NAME/ADDRESS are for the Foundry deploy script (MandateAnchor's constructor
# initialEnforcer arg). ENFORCER_KEYSTORE_* are for the enforcer/ Node service's own signing —
# an encrypted V3 keystore JSON, never a plaintext key. The DEV_PRIVATE_KEY var is the sole,
# explicitly-marked exception: Anvil/local testing only, never Sepolia or Arc testnet.
# ---------------------------------------------------------------------------
ENFORCER_ACCOUNT_NAME=
ENFORCER_ADDRESS=
ENFORCER_KEYSTORE_PATH=
ENFORCER_KEYSTORE_PASSWORD=
ENFORCER_DEV_PRIVATE_KEY_ANVIL_ONLY=
ENFORCER_MAX_STALENESS_SECONDS=900
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Frontends (landing/, web/)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.runmandate.xyz
NEXT_PUBLIC_REPO_URL=https://github.com/victor-okpukpan/mandate

# web/ only — client-side reads run in the browser, so Next.js requires the NEXT_PUBLIC_ prefix
# to inline these into the bundle. Deliberately a separate set of names from the server-side ones
# above, never the same var re-exported: that split is what keeps a server secret off the client.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_PRIVY_APP_ID=

# Set after DeployFactories.s.sol runs, once per platform instance. Every org after that,
# including a demo org, onboards through the wizard — see useOrgs()/HOW-IT-WORKS.md §4.
NEXT_PUBLIC_MANDATE_ORG_FACTORY=
NEXT_PUBLIC_MANDATE_ORG_FACTORY_DEPLOY_BLOCK=
NEXT_PUBLIC_ARC_VAULT_FACTORY=
NEXT_PUBLIC_ARC_VAULT_FACTORY_DEPLOY_BLOCK=

# Single-org fallback — used only when NEXT_PUBLIC_MANDATE_ORG_FACTORY is unset. Each page renders
# its own "not yet deployed" state until the addresses it specifically needs are set — never a
# placeholder or mock address.
NEXT_PUBLIC_MANDATE_REGISTRAR=
# The block MandateRegistrar was deployed at — the graph backfill starts here instead of
# "earliest", since public RPCs cap eth_getLogs ranges and the registrar can't have emitted
# anything before its own deployment anyway.
NEXT_PUBLIC_MANDATE_REGISTRAR_DEPLOY_BLOCK=
NEXT_PUBLIC_MANDATE_ANCHOR=
NEXT_PUBLIC_AGENT_TREASURY=

# Public, verified Arc sponsor addresses (not deployment-specific) — same default-with-override
# pattern as the RPC URLs above.
NEXT_PUBLIC_ARC_ERC8183_JOBS=0x0747EEf0706327138c69792bF28Cd525089e4583

# ---------------------------------------------------------------------------
# Agent runtimes (M9) — agents/mandated and agents/adversary.
# Either a Privy-managed wallet (PRIVY_APP_ID/SECRET already set above, plus these two) or —
# Anvil/local testing only, never a real network — AGENT_DEV_PRIVATE_KEY_ANVIL_ONLY.
# ---------------------------------------------------------------------------
AGENT_ENS_NAME=
AGENT_ROLE=
AGENT_TASK=
AGENT_PRIVY_WALLET_ID=
AGENT_ARC_WALLET_ADDRESS=
AGENT_DEV_PRIVATE_KEY_ANVIL_ONLY=
ADVERSARY_LOG_PATH=./escape-attempts.jsonl

# ---------------------------------------------------------------------------
# SeedDemo.s.sol — issues the two demo mandates ("research", "ops") shown in the landing page's
# hero replay and the test suite, against an already-deployed SEPOLIA_MANDATE_REGISTRAR. Real,
# controllable testnet addresses, not placeholders: whoever runs the live demo afterward needs to
# actually hold these keys to operate the agents.
# ---------------------------------------------------------------------------
DEMO_RESEARCH_AGENT_WALLET=
DEMO_OPS_AGENT_WALLET=
DEMO_ARC_WALLET=
