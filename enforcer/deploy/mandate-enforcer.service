[Unit]
Description=MANDATE Enforcer — syncs Sepolia mandates into Privy policies and Arc anchors
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mandate
# pnpm's --filter is a workspace-root concept — this must be the monorepo root (where
# pnpm-workspace.yaml lives), not enforcer/ itself, or the workspace won't resolve.
WorkingDirectory=/opt/mandate
# EnvironmentFile uses the same KEY=value format as .env — point it at the repo root .env
# (never commit it; this file only references its path). The Enforcer reads process.env directly
# with no dotenv step of its own (see enforcer/src/config.ts), so this is the only place these
# vars come from at runtime.
EnvironmentFile=/opt/mandate/.env
ExecStart=/usr/bin/pnpm --filter @mandate/enforcer start
Restart=always
RestartSec=5
# A crash loop shouldn't spin the CPU or spam logs forever.
StartLimitIntervalSec=300
StartLimitBurst=10

# Minimal hardening — the Enforcer only needs network access and read access to the repo; it
# writes nothing at runtime (the keystore path, if used, is read-only).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
